# Copia este fichero como .env y rellena los valores reales
# NUNCA subas .env al repositorio

SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga
JWT_SECRET_KEY=cambia-esto-por-otra-clave-aleatoria-larga
# Base de datos (PostgreSQL recomendado para producción)
DATABASE_URL=postgresql://nfc_app:LA-MISMA-QUE-DB_PASSWORD@postgres:5432/cleaning_service
DB_PASSWORD=cambia-esto-por-una-contrasena-larga
# Claude: chatbot, generacion de preguntas y traduccion de las instrucciones formativas
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui
# OpenAI: transcripcion de voz (Whisper) y audio de las instrucciones formativas (TTS)
OPENAI_API_KEY=sk-tu-clave-aqui
# Push (VAPID): si se dejan vacias, se generan solas y se guardan en instance/
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@ejemplo.com
# WhatsApp (Cloud API de Meta): para mandar a cada trabajadora el enlace a su
# horario. Sin WHATSAPP_TOKEN el panel sigue funcionando, pero hay que abrir
# WhatsApp a mano por cada persona.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nombre e idioma de la plantilla aprobada en Meta (tres parametros de cuerpo:
# nombre, semana y enlace)
WHATSAPP_TEMPLATE=horario_semanal
WHATSAPP_LANG=es
# Direccion publica de la aplicacion. Obligatoria para mandar los horarios: es
# la base del enlace que recibe cada trabajadora.
PUBLIC_BASE_URL=https://ejemplo.synology.me:8444
# Modo depuracion. A 1 habilita /api/debug/record; en produccion, sin definir
FLASK_DEBUG=
